# =============================================================================
# iMAPS environment template — NON-SECRET VALUES ONLY
# =============================================================================
#
# This file is a TEMPLATE. It contains NO real credentials and NO real secrets.
# Never copy a production `.env` into the repository.
#
# ----------------------------------------------------------------------------- 
# FieldSync bridge source identity
# -----------------------------------------------------------------------------
# REQUIRED for any deployment that writes to the shared Supabase FieldSync
# bridge project. NON-SECRET: this is an environment label, not a credential.
#
# Why it exists
#   The remote mirror tables (supabase_zoning_applications, supabase_parcels,
#   field_jobs, field_job_reviews) key iMAPS rows by bare LOCAL INTEGER ids.
#   Local ids are unique only INSIDE one iMAPS database, while the Supabase
#   project is shared by several iMAPS environments. Two environments writing
#   the same local id therefore resolved to the SAME remote row and overwrote
#   each other's assignment, application and parcel.
#
# Properties this value MUST have
#   explicit  - set it; it is never derived from hostname, APP_ENV or the
#               database name, and there is deliberately NO default
#   stable    - identical across restart, deploy and rollback
#   unique    - ONE value per LOGICAL iMAPS source. Read this carefully:
#                 * the SAME logical database/environment keeps the SAME id
#                   across restarts, deploys and rebuilds;
#                 * ANY independent clone or database that can WRITE to this
#                   Supabase project MUST be given a NEW id.
#               An independent clone that keeps the parent source's id is
#               exactly the collision this namespace exists to prevent: it
#               reproduces the original defect, because bare local integer ids
#               are unique only inside one database.
#   non-secret- safe to read, log and commit in configuration
#
# Rules
#   - 2-63 characters: letters, digits, dot, underscore, hyphen.
#   - No comma, parenthesis, quote, whitespace or colon (PostgREST filter
#     syntax would reinterpret the value).
#   - Shared placeholders are REJECTED at runtime: default, none, null, nil,
#     undefined, changeme, todo, fixme, localhost, example, placeholder.
#   - A write that needs bridge identity WITHOUT this value FAILS CLOSED. It is
#     never retried against another environment's namespace.
#
# Example for THIS logical source (Rosario, iMAPS local database 0921):
IMAPS_BRIDGE_SOURCE_ID=rosario-imaps-local-0921-a
#
# If you clone this database, or stand up an independent environment that can
# write to the same Supabase project, set a DIFFERENT value. Copying the value
# above into an independently writable clone reintroduces the collision.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=iMAPS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Database — PostgreSQL + PostGIS, REQUIRED
# -----------------------------------------------------------------------------
# NOT OPTIONAL and NOT SUBSTITUTABLE. The schema declares
# geometry(MultiPolygon,4326) / geometry(Polygon,4326) columns on
# barangay_boundary, land_parcels, land_use_plan, parcels and rosario_boundary,
# and the map, search, tax-map and forecast code queries them with ST_SetSRID,
# ST_Transform, ST_Intersects and ST_Centroid. Plain PostgreSQL is not enough —
# the PostGIS extension must exist IN THIS DATABASE:
#
#   psql -U postgres -d imaps_db -c "CREATE EXTENSION postgis;"
#
# On Windows, PostGIS comes from Stack Builder in the EDB PostgreSQL installer.
# `php artisan migrate` refuses to run without it, and refuses to run on any
# driver other than pgsql (the SQLite path exists for the test suite only).
# There is no SQLite fallback; database/database.sqlite is not one.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=imaps_db
DB_USERNAME=postgres
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Urban growth forecasting microservice — EXTERNAL, NOT IN THIS REPOSITORY
# -----------------------------------------------------------------------------
# The FastAPI/SARIMAX service that answers /api/v1/forecast is deployed
# separately; its source is not in this repo or its git history (see README,
# "Urban growth forecasting"). Leave both blank if it is not deployed: the
# feature then returns HTTP 503 and the UI shows an error. It never invents
# forecast numbers.
#
# NO DEFAULT KEY IS SET HERE ON PURPOSE. A fallback secret in source makes a
# missing environment variable look like a working install.
FORECAST_SERVICE_URL=http://localhost:8002/api/v1/forecast
FORECAST_SERVICE_API_KEY=
# Seconds. The service trains an XGBoost model per request and loads shapefiles
# on the first call: measured ~24s warm and over 30s cold, so Guzzle's 30s
# default cut the request off mid-forecast. Keep a wide margin, and make sure
# the web server agrees (nginx fastcgi_read_timeout / php-fpm request_terminate_timeout).
FORECAST_SERVICE_TIMEOUT=180

# Shapefile/geodata helper service (also external).
FASTAPI_BASE_URL=http://127.0.0.1:8001
FASTAPI_TIMEOUT=30

# -----------------------------------------------------------------------------
# Supabase FieldSync bridge — server-side only, never expose as VITE_*
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
